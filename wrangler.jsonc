{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allen-gillon",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "allengillon.com",
      "custom_domain": true
    },
    {
      "pattern": "www.allengillon.com",
      "custom_domain": true
    },
    {
      "pattern": "other.allengillon.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    // dist/client holds no HTML. "none" also stops vinext dev serving the
    // legacy root *.html files (books.html, music.html...) over app routes.
    "html_handling": "none",
    // The static-asset path ignores Range, so browsers could not seek audio.
    // Media goes through app/audio and app/videos route handlers instead
    // (lib/media-range.mjs), which Workers Caching can slice into 206s.
    "run_worker_first": ["/audio/*", "/videos/*"],
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "REVIEWS_DB",
      "database_name": "allen-gillon-reviews",
      "database_id": "ccd335c6-56c8-4b99-8c84-bb300e5f1a78",
      "migrations_dir": "migrations"
    }
  ]
}
