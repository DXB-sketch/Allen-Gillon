# Keep checkout disabled until credentials, stock and sandbox checks are complete.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# The canonical origin for this environment, with no trailing slash.
SITE_URL=http://localhost:3100
# Use a TLS-enabled pooled Postgres connection; separate test and production databases.
DATABASE_URL=
